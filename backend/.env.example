# =============================================================================
#  NOVATHESIS BACKEND — BIẾN MÔI TRƯỜNG
# =============================================================================
#  Sao chép tệp này thành `.env` rồi điền giá trị thật.
#  `Yêu cầu dự án.md` §2.1: TUYỆT ĐỐI không hardcode khoá bí mật trong mã nguồn
#  và không lưu chúng vào bảng `system_configs`.
# =============================================================================

NODE_ENV=development
PORT=8000
# Gốc công khai của chính API — dùng để ký URL tải tệp.
API_PUBLIC_URL=http://localhost:8000
# Gốc của frontend — dùng trong link email và danh sách CORS.
APP_PUBLIC_URL=http://localhost:3000
# Nhiều origin thì phân cách bằng dấu phẩy. Để trống = chỉ cho APP_PUBLIC_URL.
CORS_ORIGINS=http://localhost:3000

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Cổng 5433 (không phải 5432) để không đụng PostgreSQL cài sẵn trên máy.
DATABASE_URL="postgresql://neondb_owner:npg_tVL8s4FpRdlq@ep-purple-mouse-ayl7lz26.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Bí mật -----------------------------------------------------------------
# Sinh chuỗi mới:  openssl rand -hex 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-48-byte-truoc-khi-chay-that
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=14

# SameSite của cookie phiên đăng nhập (lax | strict | none).
# `lax` đúng khi frontend và backend cùng tên miền đăng ký (khác cổng vẫn là
# same-site). Hai tên miền khác nhau hẳn thì đổi sang `none` — khi đó bắt buộc
# NODE_ENV=production để cookie có cờ Secure, nếu không trình duyệt sẽ từ chối.
COOKIE_SAMESITE=lax
# Khoá ký URL tải tệp (signed URL). Khác JWT_SECRET để giới hạn thiệt hại.
FILE_URL_SECRET=thay-bang-chuoi-ngau-nhien-khac
FILE_URL_TTL_SECONDS=300

# --- Lưu trữ ----------------------------------------------------------------
# Thư mục riêng tư, KHÔNG phục vụ tĩnh. Mọi lượt tải đều qua endpoint có kiểm
# tra quyền hoặc qua signed URL hết hạn sau FILE_URL_TTL_SECONDS.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- Email (UC 1.2, 1.4, 1.5, 8.2) -----------------------------------------
# Mặc định trỏ vào Mailpit trong docker-compose: mở http://localhost:8025 để
# đọc mọi email hệ thống gửi ra mà không cần tài khoản SMTP thật.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NovaThesis <no-reply@novathesis.edu.vn>"

# --- AI ---------------------------------------------------------------------
# Nhà cung cấp embedding: local | openai | gemini
#   local  — vector hoá cục bộ (hashing + n-gram, có xử lý dấu tiếng Việt).
#            Chạy được ngay, không cần khoá API, không gửi dữ liệu ra ngoài.
#            Đủ để demo toàn bộ luồng pgvector/HNSW/RAG.
#   openai — text-embedding-3-small (1536 chiều, khớp đúng cột vector).
#   gemini — text-embedding-004 (768 chiều, hệ thống tự đệm lên 1536).
EMBEDDING_PROVIDER=local

# Nhà cung cấp sinh văn bản: local | anthropic | openai | gemini
#   local  — trả lời bằng cách trích và ghép các đoạn tài liệu tìm được
#            (extractive). Không "sáng tác", nên không bịa, nhưng câu văn kém
#            mượt hơn mô hình thật. Dùng khi chưa có khoá API.
LLM_PROVIDER=local

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ngân sách ngữ cảnh RAG.
RAG_TOP_K=5
# Sàn tuyệt đối để loại kết quả rác. Việc chọn lọc thật dùng ngưỡng TƯƠNG ĐỐI
# (giữ kết quả đạt >= 45% điểm của kết quả đầu bảng), nên con số này chỉ cần nhỏ.
RAG_MIN_SCORE=0.05
RAG_CONTEXT_TOKENS=3000

# --- Worker nền & watchdog (Yêu cầu dự án §2.4) -----------------------------
# Số tài liệu xử lý song song. Đọc PDF và nhúng vector là tác vụ nặng.
WORKER_CONCURRENCY=2
# Quá thời gian này coi như worker treo → huỷ, tăng số lần thử, đưa lại hàng đợi.
WORKER_TIMEOUT_MS=120000
WORKER_MAX_ATTEMPTS=3
# Chu kỳ quét tìm job treo.
WATCHDOG_INTERVAL_MS=30000

# --- Lập lịch (UC 8.8) ------------------------------------------------------
# Cron nhắc deadline milestone. Mặc định 07:00 mỗi ngày.
REMINDER_CRON=0 7 * * *
REMINDER_DAYS=7,3,1

# --- Bảo mật ----------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Khởi tạo cơ sở dữ liệu -------------------------------------------------
# `npm run db:seed` tạo tham số hệ thống và ĐÚNG MỘT tài khoản quản trị.
# Cả hai biến dưới đây BẮT BUỘC phải đặt — seed sẽ dừng lại nếu thiếu. Không có
# giá trị mặc định là chủ ý: một mật khẩu quản trị viết sẵn trong kho công khai
# thì mọi bản cài đặt quên đổi đều dùng chung một cánh cửa.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị viên

# Mật khẩu chung cho các tài khoản của `npm run db:seed:demo` (chỉ môi trường
# phát triển — lệnh đó tự từ chối chạy khi NODE_ENV=production).
SEED_PASSWORD=Admin@123456

LOG_LEVEL=info
